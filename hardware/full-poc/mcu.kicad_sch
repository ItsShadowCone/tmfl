	(text "Shitty Add-On (SAO) V1.69bis\n\n1 3v3\n2 GND\n3 SDA   = GPIO44  = I2C0 SDA = SPI1 RX  = UART0 TX\n4 SCL   = GPIO45  = I2C0 SCL = SPI1 CS  = UART0 RX\n5 GPIO1 = GPIO46  =          = SPI1 SCK = UART0 TX\n6 GPIO2 = GPIO47  =          = SPI1 TX  = UART0 RX\n\nall pins also support analog input"
		(exclude_from_sim no)
